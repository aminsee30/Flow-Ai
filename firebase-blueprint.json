{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "User brand workspace containing brand memory, target audience, voice, and products.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID matching auth.uid"
        },
        "name": {
          "type": "string",
          "description": "Workspace name"
        },
        "brandProfile": {
          "type": "object",
          "description": "Brand details such as brand name, industry, and description"
        },
        "targetAudience": {
          "type": "object",
          "description": "Audience persona, pain points, and desires"
        },
        "brandVoice": {
          "type": "string",
          "description": "Tone of voice"
        },
        "customVoiceStyle": {
          "type": "string",
          "description": "Custom guidelines for tone"
        },
        "forbiddenWords": {
          "type": "array",
          "description": "List of words or phrases to avoid"
        },
        "products": {
          "type": "array",
          "description": "Catalog of products or services offered by the brand"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "name"]
    },
    "Idea": {
      "title": "Idea",
      "description": "Content ideas generated by AI or saved by the creator.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "workspaceId": {
          "type": "string",
          "description": "Workspace document ID"
        },
        "title": {
          "type": "string",
          "description": "Idea title or hook premise"
        },
        "description": {
          "type": "string",
          "description": "Idea outline and description"
        },
        "contentType": {
          "type": "string",
          "description": "Format: reel, carousel, or story"
        },
        "contentPillar": {
          "type": "string",
          "description": "Pillar such as educational, authority, sales"
        },
        "goal": {
          "type": "string",
          "description": "Primary goal"
        },
        "status": {
          "type": "string",
          "description": "Current pipeline status"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "title", "contentType"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "Full production content item for reels, carousels, stories, and scenarios.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "workspaceId": {
          "type": "string",
          "description": "Workspace document ID"
        },
        "ideaId": {
          "type": "string",
          "description": "Optional parent idea ID"
        },
        "title": {
          "type": "string",
          "description": "Title of content item"
        },
        "contentType": {
          "type": "string",
          "description": "reel, carousel, story, scenario"
        },
        "stage": {
          "type": "string",
          "description": "Kanban pipeline stage"
        },
        "status": {
          "type": "string",
          "description": "Content status"
        },
        "scheduledDate": {
          "type": "string",
          "description": "Scheduled calendar date YYYY-MM-DD"
        },
        "scheduledTime": {
          "type": "string",
          "description": "Scheduled calendar time HH:MM"
        },
        "hook": {
          "type": "string",
          "description": "Selected hook"
        },
        "hooks": {
          "type": "array",
          "description": "List of alternative hooks"
        },
        "scenarioText": {
          "type": "string",
          "description": "Full scenario script"
        },
        "caption": {
          "type": "string",
          "description": "Social media caption"
        },
        "hashtags": {
          "type": "array",
          "description": "List of hashtags"
        },
        "cta": {
          "type": "string",
          "description": "Call to action"
        },
        "reelBlueprint": {
          "type": "object",
          "description": "Reel duration, scenes, voiceover, and shooting tips"
        },
        "carouselSlides": {
          "type": "array",
          "description": "Slides content and visual directions"
        },
        "storySequence": {
          "type": "array",
          "description": "Sequence of story steps"
        },
        "notes": {
          "type": "string",
          "description": "User notes"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "title", "contentType", "stage"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Workspace data owned by the authenticated creator."
    },
    "/ideas/{ideaId}": {
      "schema": {
        "$ref": "#/entities/Idea"
      },
      "description": "Generated and saved ideas belonging to users."
    },
    "/contents/{contentId}": {
      "schema": {
        "$ref": "#/entities/ContentItem"
      },
      "description": "Production content items belonging to users."
    }
  }
}
